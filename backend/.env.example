# Backend Environment Variables (.env or production config)

# Environment mode (production vs development)
ENVIRONMENT=development

# Database URL (SQLite for local dev, PostgreSQL for production e.g. postgresql://user:pass@host:5432/dbname)
DATABASE_URL=sqlite:///./dovite_journal.db

# JWT Secret Key (MUST be changed in production e.g. generated via `openssl rand -hex 32`)
JWT_SECRET_KEY=your_super_secret_jwt_key_here

# Allowed CORS Origins (comma-separated list of allowed frontend domains)
ALLOWED_ORIGINS=http://localhost:3000,https://dovitejournal.org

# Stripe API Keys & Webhook Secret
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Email Configuration (HTTP APIs use HTTPS Port 443 - NEVER blocked by Render or local ISPs)

# Option A: Brevo API (RECOMMENDED FOR CLIENT TESTING & FREE PROD: 300 free emails/day to ANY external recipient without custom domain verification!)
# Sign up free at https://brevo.com -> API Keys -> Create API Key
# BREVO_API_KEY=xkeysib-123456789abcdef...

# Option B: SendGrid API (100 free emails/day forever via HTTPS Port 443)
# Sign up free at https://sendgrid.com -> Settings -> API Keys
# SENDGRID_API_KEY=SG.123456789abcdef...

# Option C: Resend API (3,000 free emails/month via HTTPS Port 443 - requires verified domain or sends only to registered account address on free tier)
# RESEND_API_KEY=re_123456789_placeholder

# Option D: Direct SMTP Backup (Note: Render free tier & many local Wi-Fi networks block outbound ports 465/587)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Sender & Recipient addresses
SENDER_EMAIL=your_email@gmail.com
EDITOR_EMAIL=petertoluwani9@gmail.com
