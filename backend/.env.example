# Backend Environment Variables (.env or production config)

# Environment mode (production vs development)
ENVIRONMENT=development

# Database URL (SQLite for local dev, PostgreSQL for production e.g. postgresql://user:pass@host:5432/dbname)
DATABASE_URL=sqlite:///./dovite_journal.db

# JWT Secret Key (MUST be changed in production e.g. generated via `openssl rand -hex 32`)
JWT_SECRET_KEY=your_super_secret_jwt_key_here

# Allowed CORS Origins (comma-separated list of allowed frontend domains)
ALLOWED_ORIGINS=http://localhost:3000,https://dovitejournal.org

# Stripe API Keys & Webhook Secret
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Email Configuration (Resend API is recommended for production serverless deployment)
# Option A: Resend API Key (https://resend.com - free tier 3,000 emails/month)
RESEND_API_KEY=re_123456789_placeholder

# Option B: Direct SMTP (Gmail / Outlook / Custom SMTP Server)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_journal_email@gmail.com
SMTP_PASSWORD=your_app_password

# Sender & Recipient addresses
SENDER_EMAIL=noreply@dovitejournal.org
EDITOR_EMAIL=editor@dovitejournal.org
